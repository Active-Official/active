# ============================================================
# SOLID language repository — .gitignore
# ============================================================

# Scratch work area — experiments, drafts, throwaway code.
# NEVER committed. This is the only place for untracked mess.
scratch/

# Original reference material — the founding Grok conversation and every
# file it produced. Reference only; NEVER committed or published.
original-reference-files/

# Private working notes — docs/ is public, these files are NOT.
# Agent handbooks, memory logs, and the Grok origin documents
# (copied here for reference) live only on this machine.
docs/Agent-Handbook.md
docs/Memories-and-Observations.md
docs/DESIGN.md
docs/checklist.md
docs/proposal.md
docs/Grok-Better\ TOML\ Language\ Design\ with\ YAML\ JSON\ Features-20261015-0719.md

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Build artifacts & dependencies (implementation language TBD —
# these cover the usual suspects so nothing leaks early)
node_modules/
target/
dist/
build/
*.vsix
out/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Temp / log files
*.tmp
*.log
*.bak

# Fuzzing artifacts (cargo-fuzz)
fuzz/artifacts/
fuzz/corpus/
