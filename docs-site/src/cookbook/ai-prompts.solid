# AI agent prompts: semantic blocks keep role, rules, and template
# distinct for tooling (highlighting, extraction, review) while
# evaluating to plain strings.
@prompt """
You are a release assistant. Answer briefly and cite file paths.
"""

@policy """
Never invent configuration values. Quote sources for every claim.
"""

changelog = @template """
## Release ${version}

${notes}
"""

version = "1.0.0"
notes = "- Faster evaluation"
entry = "v${version} ready"
