# Terraform-style variables: typed inputs with defaults and bounds,
# exactly like variable blocks — but validated before apply, not
# during.
schema:
  closed = true
  region = String(default = "us-east-1")
  instance_count = Int(min = 1, max = 100, default = 2)
  instance_type = Enum("t3.micro", "t3.small", "t3.medium")
  enable_monitoring = Bool(default = true)

region = "eu-west-1"

instance_count = 3

instance_type = "t3.small"

enable_monitoring = true
