{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Active debugger step export",
  "type": "object",
  "required": ["breakpoint", "matched", "total_steps", "steps"],
  "properties": {
    "breakpoint": { "type": ["string", "null"] },
    "matched": { "type": ["integer", "null"], "minimum": 0 },
    "total_steps": { "type": "integer", "minimum": 0 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "path", "kind", "tainted", "value", "codes"],
        "properties": {
          "node": { "type": "integer", "minimum": 0 },
          "path": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "tainted": { "type": "boolean" },
          "value": {},
          "codes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
