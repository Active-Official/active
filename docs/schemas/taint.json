{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Active taint flow export",
  "type": "object",
  "required": ["version", "nodes", "edges", "sources", "export_points"],
  "properties": {
    "version": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "secret"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "type": "string" },
          "secret": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sources": { "type": "array", "items": { "type": "string" } },
    "export_points": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
