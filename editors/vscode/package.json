{
  "name": "active-lang",
  "displayName": "Active",
  "description": "Active configuration language: safer than YAML, more expressive than TOML, more human-friendly than JSON",
  "version": "1.2.0",
  "publisher": "ratioartificiosa",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Active-Official/active.git"
  },
  "homepage": "https://github.com/Active-Official/active",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "active",
    "config",
    "configuration",
    "toml",
    "yaml",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:active"
  ],
  "main": "./client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "active",
        "aliases": [
          "active",
          "active"
        ],
        "extensions": [
          ".active"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "active",
        "scopeName": "source.active",
        "path": "./syntaxes/active.tmGrammar.json"
      }
    ],
    "configuration": {
      "title": "active",
      "properties": {
        "active.languageServer.path": {
          "type": "string",
          "default": "active-lsp",
          "description": "Path to the active-lsp language server binary (PATH lookup by default; cargo install active-lsp)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
