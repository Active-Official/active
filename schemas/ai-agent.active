# Standard AI agent schema (ACTIVE schema library).
schema {
  closed = true
  # Model identifier (provider-specific).
  model = String
  # Sampling temperature, 0.0 to 2.0.
  temperature = Float(min = 0.0, max = 2.0, default = 1.0)
  # Maximum completion tokens.
  max_tokens = Int(min = 1, default = 1024)
  # Retry budget on provider errors.
  retries = Int(min = 0, max = 10, default = 3)
}
