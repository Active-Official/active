# Standard feature-flag schema (ACTIVE schema library).
schema {
  closed = true
  # Flag entries (inline element fields carry no per-field docs by
  # parser design: statement-level attachment only).
  flags = Array<Table {
    closed = true,
    name = String,
    enabled = Bool(default = false),
    rollout = Int(min = 0, max = 100, default = 0),
  }>
}
