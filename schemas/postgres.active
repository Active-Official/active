# Standard PostgreSQL schema (ACTIVE schema library).
schema {
  closed = true
  # Database host name.
  host = String
  # TCP port.
  port = Int(min = 1, max = 65535, default = 5432)
  # Database name.
  database = String
  # Login role.
  user = String
  # Login secret (tainted, redacted).
  password = Secret
  # Connection pool size.
  pool = Int(min = 1, max = 100, default = 5)
}
