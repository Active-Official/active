let base = 10
let name = "svc"

[calc]
doubled = "value: ${base * 2}"
compare = "gt=${base > 5}"
mixed = "a${base}b${name}c"
escaped = "literal \${not_interpolated}"
literal_single = 'no ${interpolation} here'
fallback = "host=${env.SOLID_CORPUS_UNSET ?: 'local'}"
nested = "outer ${ \"inner ${name}\" }"
